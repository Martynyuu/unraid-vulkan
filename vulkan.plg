<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name        "vulkan">
  <!ENTITY author      "Martynyuu">
  <!ENTITY version     "2026.10.27">
  <!ENTITY pkgversion  "2026.10.27">
  <!ENTITY pkgbuild    "1">
  <!ENTITY md5         "aff7049f010fb622e99acb38f38e7adb">
  <!ENTITY vulkansdk   "1.4.363.0">
  <!ENTITY github      "Martynyuu/unraid-vulkan">
  <!ENTITY pluginURL   "https://raw.githubusercontent.com/&github;/main/&name;.plg">
  <!ENTITY pluginLOC   "/boot/config/plugins/&name;">
  <!ENTITY emhttpLOC   "/usr/local/emhttp/plugins/&name;">
  <!ENTITY pkgname     "&name;-&pkgversion;-x86_64-&pkgbuild;">
]>
<!--
  version, pkgversion and md5 are set by the release workflow
  (.github/workflows/release.yml). vulkansdk is read by build.sh.
-->

<PLUGIN  name="&name;"
         author="&author;"
         version="&version;"
         pluginURL="&pluginURL;"
         launch="Settings/&name;"
         icon="microchip"
         min="6.10.0"
         support="https://github.com/&github;/issues"
>

<CHANGES>
###2026.10.27
- Vulkan loader and vulkaninfo updated to Vulkan SDK 1.4.363.0, built from the Khronos sources on Ubuntu 20.04 (runs on Unraid 6.10 and later; the old package needed glibc 2.34)
- Proper Slackware package name (vulkan-VERSION-x86_64-1.txz), clean upgrades and removal
- The NVIDIA driver's own ICD manifest is used when present; a manifest is only generated when it is missing
- Warning when libGLX_nvidia.so.0 is missing (NVIDIA Driver plugin not installed)
- Removed the global VK_ICD_FILENAMES export from /etc/profile.d (it hid every other Vulkan driver on the host)
- Web page: ICD source, loader version, vulkaninfo with a timeout, one Docker recommendation (--runtime=nvidia)
- Release workflow writes version and MD5 into this file

###2026.03.02b
- Fixed package download (using Ubuntu vulkan-tools)
- vulkaninfo --summary now works in terminal

###2026.03.02a
- Added vulkaninfo and Vulkan tools installation

###2026.03.02
- Initial release
- NVIDIA Vulkan ICD configuration
- Docker container support
</CHANGES>

<!-- Remove packages and downloads of other versions (incl. the old vulkan-vYYYY.MM.DD.txz) -->
<FILE Run="/bin/bash">
<INLINE>
PKGDB=/var/lib/pkgtools/packages
[ -d "$PKGDB" ] || PKGDB=/var/log/packages
# Packages of versions &lt;= 2026.03.02b were not Slackware-named, upgradepkg
# cannot replace them. Newer vulkan-*-x86_64-* packages are upgraded below.
for p in "$PKGDB"/vulkan-v[0-9]*; do
  [ -e "$p" ] &amp;&amp; removepkg "$(basename "$p")" &gt;/dev/null 2&gt;&amp;1
done
mkdir -p &pluginLOC;
find &pluginLOC; -maxdepth 1 -name 'vulkan-*.txz' ! -name '&pkgname;.txz' -delete 2&gt;/dev/null
</INLINE>
</FILE>

<!-- Vulkan loader + vulkaninfo + plugin files -->
<FILE Name="&pluginLOC;/&pkgname;.txz" Run="upgradepkg --install-new">
<URL>https://github.com/&github;/releases/download/v&pkgversion;/&pkgname;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "=============================================="
echo " Vulkan Support for Unraid &version;"
echo "=============================================="
ldconfig 2&gt;/dev/null
bash &emhttpLOC;/scripts/icd-setup.sh install

if command -v vulkaninfo &gt;/dev/null 2&gt;&amp;1; then
  echo " Loader: $(readlink /usr/lib64/libvulkan.so.1)  -  check with: vulkaninfo --summary"
else
  echo " WARNING: vulkaninfo not found - the package did not install correctly"
fi
echo ""
echo " Docker: --runtime=nvidia -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all"
echo "         (fallback mount: -v /etc/vulkan/icd.d:/etc/vulkan/icd.d:ro)"
echo "=============================================="
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Removing Vulkan Support..."
[ -x &emhttpLOC;/scripts/icd-setup.sh ] &amp;&amp; bash &emhttpLOC;/scripts/icd-setup.sh remove
removepkg &pkgname; 2&gt;/dev/null
rm -rf &emhttpLOC;
rm -rf &pluginLOC;
ldconfig 2&gt;/dev/null
echo "Done."
</INLINE>
</FILE>

</PLUGIN>
