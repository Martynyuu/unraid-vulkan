<?php
$plugin = 'vulkan';
$docroot = '/usr/local/emhttp/plugins/' . $plugin;

function vk_run($cmd, $seconds) {
  // coreutils timeout: a hung driver must never block the web UI.
  return (string)shell_exec('timeout ' . (int)$seconds . ' ' . $cmd . ' 2>&1');
}

$nvidia_smi = trim(vk_run('nvidia-smi --query-gpu=name,driver_version --format=csv,noheader', 5));
if ($nvidia_smi === '' || stripos($nvidia_smi, 'not found') !== false || stripos($nvidia_smi, 'failed') !== false) {
  $nvidia_smi = '';
}

$state = @parse_ini_file('/var/local/emhttp/plugins/vulkan/icd.state') ?: [];
$icd_source   = $state['SOURCE']   ?? '';
$icd_manifest = $state['MANIFEST'] ?? '';
$icd_library  = $state['LIBRARY']  ?? '';
$icd_api      = $state['API_VERSION'] ?? '';

$loader_real = @readlink('/usr/lib64/libvulkan.so.1');
$loader_version = ($loader_real && preg_match('/libvulkan\.so\.(\d+\.\d+\.\d+)/', $loader_real, $m)) ? $m[1] : '';
$sdk_version = trim((string)@file_get_contents("$docroot/VULKAN_SDK_VERSION"));

$vulkaninfo = is_executable('/usr/bin/vulkaninfo');
$summary = '';
$summary_timeout = false;
if ($vulkaninfo) {
  $summary = vk_run('/usr/bin/vulkaninfo --summary', 10);
  // timeout(1) exits with 124 and prints nothing; detect empty output.
  if (trim($summary) === '') $summary_timeout = true;
}

// Fallback mount: the whole /etc/vulkan/icd.d when the manifest lives there,
// otherwise just the driver's manifest file (do not drag Mesa ICDs along).
if ($icd_manifest === '' || dirname($icd_manifest) === '/etc/vulkan/icd.d') {
  $icd_mount = '/etc/vulkan/icd.d:/etc/vulkan/icd.d:ro';
} else {
  $icd_mount = $icd_manifest . ':/etc/vulkan/icd.d/nvidia_icd.json:ro';
}

function vk_badge($ok, $text) {
  return ($ok ? '<span style="color:#4caf50">&#10004;</span> ' : '<span style="color:#f44336">&#10008;</span> ') . htmlspecialchars($text);
}
?>
<style>
.vk-pre{background:#1a1a1a;color:#ddd;padding:10px;border-radius:4px;overflow-x:auto;white-space:pre}
.vk-table td{padding:3px 12px 3px 0;vertical-align:top}
</style>
<div style="padding:10px 20px">
<table class="vk-table">
<tr><td><b>NVIDIA driver</b></td><td><?= vk_badge($nvidia_smi !== '', $nvidia_smi !== '' ? $nvidia_smi : 'not detected (install the NVIDIA Driver plugin)') ?></td></tr>
<tr><td><b>Vulkan ICD</b></td><td><?php
  if ($icd_source === 'driver') {
    echo vk_badge(true, "provided by the NVIDIA driver: $icd_manifest" . ($icd_api ? " (api $icd_api)" : ''));
  } elseif ($icd_source === 'generated') {
    echo vk_badge(true, "generated by this plugin: $icd_manifest (api $icd_api) - the driver ships no manifest");
  } else {
    echo vk_badge(false, 'not configured - reinstall the plugin');
  }
?></td></tr>
<tr><td><b>NVIDIA Vulkan library</b></td><td><?= vk_badge($icd_library !== '', $icd_library !== '' ? $icd_library : 'libGLX_nvidia.so.0 not found') ?></td></tr>
<tr><td><b>Vulkan loader</b></td><td><?= vk_badge($loader_version !== '', $loader_version !== '' ? "libvulkan.so.$loader_version" . ($sdk_version ? " (Vulkan SDK $sdk_version)" : '') : 'not installed') ?></td></tr>
<tr><td><b>vulkaninfo</b></td><td><?= vk_badge($vulkaninfo, $vulkaninfo ? '/usr/bin/vulkaninfo' : 'not installed') ?></td></tr>
</table>

<?php if ($vulkaninfo): ?>
<h3>vulkaninfo --summary</h3>
<?php if ($summary_timeout): ?>
<p style="color:#f44336">vulkaninfo did not answer within 10 seconds.</p>
<?php else: ?>
<div class="vk-pre"><?= htmlspecialchars($summary) ?></div>
<?php endif; ?>
<?php endif; ?>

<h3>Docker containers</h3>
<p>Use the NVIDIA runtime with the <code>graphics</code> capability (included in <code>all</code>).
The NVIDIA Container Toolkit then mounts the driver libraries and this host's Vulkan ICD manifest into the container.
The read-only ICD mount is a fallback for older toolkit versions and does no harm otherwise.</p>
<div class="vk-pre">--runtime=nvidia
-e NVIDIA_VISIBLE_DEVICES=all
-e NVIDIA_DRIVER_CAPABILITIES=all
-v <?= htmlspecialchars($icd_mount) ?></div>
<p>In an Unraid template: <i>Extra Parameters</i> <code>--runtime=nvidia</code>, variables
<code>NVIDIA_VISIBLE_DEVICES</code> = <code>all</code> (or a GPU UUID from <code>nvidia-smi -L</code>) and
<code>NVIDIA_DRIVER_CAPABILITIES</code> = <code>all</code>.
Inside the container, <code>vulkaninfo --summary</code> should list the NVIDIA GPU.</p>
</div>
